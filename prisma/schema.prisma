generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  nickname      String    @unique
  password      String
  marks         Int       @default(100)
  isJudge       Boolean   @default(false)
  lastActive    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shops                   Shop[]
  ordersAsCustomer        Order[]        @relation("CustomerOrders")
  sentTransactions        Transaction[]  @relation("SentTransactions")
  receivedTransactions    Transaction[]  @relation("ReceivedTransactions")
  reports                 Report[]       @relation("Reporter")
  reportedBy              Report[]       @relation("Reported")
  trialsAsDefendant       Trial[]        @relation("Defendant")
  trialsAsPlaintiff       Trial[]        @relation("Plaintiff")
  notifications           Notification[]
  suggestions             Suggestion[]
}

model Government {
  id            String    @id @default(cuid())
  marks         Int       @default(400)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        GovernmentOrder[]
  taxRecords    TaxRecord[]
}

model TaxRecord {
  id              String      @id @default(cuid())
  governmentId    String
  government      Government  @relation(fields: [governmentId], references: [id])

  transactionId   String
  senderNickname  String
  receiverNickname String
  originalAmount  Int
  taxAmount       Int

  createdAt       DateTime    @default(now())
}

model GovernmentOrder {
  id              String      @id @default(cuid())
  governmentId    String
  government      Government  @relation(fields: [governmentId], references: [id])
  shopId          String
  shopName        String
  ownerNickname   String

  description     String
  amount          Int

  createdAt       DateTime    @default(now())
}

model Shop {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  jobTitle    String
  description String?
  isOpen      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  menuItems   MenuItem[]
  orders      Order[]
  suggestions Suggestion[]
}

model Job {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MenuItem {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  basePrice     Int?
  estimatedTime String?
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid())
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id])

  customRequest   String
  proposedPrice   Int?
  estimatedDate   String?
  ownerMessage    String?

  status          String      @default("PENDING")
  isPaid          Boolean     @default(false)
  isDelivered     Boolean     @default(false)
  canReport       Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reports         Report[]    @relation("OrderReports")
}

model Transaction {
  id              String            @id @default(cuid())
  senderId        String
  sender          User              @relation("SentTransactions", fields: [senderId], references: [id])
  receiverId      String
  receiver        User              @relation("ReceivedTransactions", fields: [receiverId], references: [id])

  amount          Int
  description     String
  status          String            @default("PENDING")

  hasObjection    Boolean           @default(false)
  objectionReason String?
  objectionStatus String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Report {
  id            String       @id @default(cuid())
  reporterId    String
  reporter      User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedId    String
  reported      User         @relation("Reported", fields: [reportedId], references: [id])

  orderId       String?
  order         Order?       @relation("OrderReports", fields: [orderId], references: [id])

  reason        String
  evidence      String?
  status        String       @default("PENDING")

  createdAt     DateTime     @default(now())

  trial         Trial?
}

model Trial {
  id              String      @id @default(cuid())
  reportId        String      @unique
  report          Report      @relation(fields: [reportId], references: [id])

  defendantId     String
  defendant       User        @relation("Defendant", fields: [defendantId], references: [id])
  plaintiffId     String
  plaintiff       User        @relation("Plaintiff", fields: [plaintiffId], references: [id])

  scheduledAt     String?
  verdict         String?
  fineAmount      Int?
  fineReduced     Boolean     @default(false)
  finalFine       Int?

  status          String      @default("SCHEDULED")

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)

  createdAt   DateTime         @default(now())
}

model Suggestion {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  status      String    @default("PENDING")
  reply       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
